# SMTP credentials for the /contact form's email notification (src/lib/mailer.ts).
# Works with any SMTP provider — Resend, Postmark, SES, Gmail app passwords, etc.
# Without these set, submissions are still validated and accepted, but only
# logged to the server console instead of emailed (see route.ts warning).

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where contact-form notifications are sent, and the From address used to send them.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
