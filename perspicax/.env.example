# Resend API key for the /contact form's email notification (src/lib/mailer.ts).
# Get one at https://resend.com/api-keys.
# Without this set, submissions are still validated and accepted, but only
# logged to the server console instead of emailed (see route.ts warning).
RESEND_API_KEY=

# Optional overrides — defaults live in src/lib/mailer.ts:
#   from: onboarding@resend.dev (Resend's shared test sender; switch once a
#         custom domain is verified in Resend — sending from anything else
#         requires a verified domain)
#   to:   alfredpahmen@gmail.com
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
